NODE_ENV=development
PORT=3001
DATABASE_URL="file:./data/mc-manager.db"
# Obligatoires, 32 caractères minimum, différents l'un de l'autre : openssl rand -hex 32
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars
ENCRYPTION_KEY=change-this-to-a-different-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
# Origine exacte utilisée par le navigateur (valeur CORS)
FRONTEND_URL=http://localhost:5173
FRONTEND_PORT=3000

# Serveur Minecraft
MC_CONTAINER=mc
MC_BACKUP_CONTAINER=mc-backup
MC_DATA_DIR=/mc/data
MC_BACKUPS_DIR=/mc/backups
# Défaut : MC_CONTAINER et 25575
MC_RCON_HOST=
MC_RCON_PORT=25575
# Dans le conteneur, le socket est toujours monté sur /var/run/docker.sock :
# DOCKER_SOCKET ne sert que si le backend tourne hors Docker (pnpm dev).
DOCKER_SOCKET=/var/run/docker.sock

# Déploiement Docker (docker-compose.yml)
# Noms des volumes Docker existants du serveur Minecraft et des backups
# (créés par la stack Minecraft, déclarés external : jamais créés ici)
MC_DATA_VOLUME=mc-data
MC_BACKUPS_VOLUME=mc-backups
# Réseau Docker partagé avec le conteneur Minecraft (pour joindre RCON)
MC_NETWORK=mc-network
# GID du groupe propriétaire du socket Docker, pour que l'utilisateur node du
# conteneur puisse le lire. Sur l'hôte : stat -c %g /var/run/docker.sock
DOCKER_GID=999
