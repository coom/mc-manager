# syntax=docker/dockerfile:1.4
# Node 20 reached end-of-life in April 2026 - track the active LTS line.
FROM node:22-slim AS base
RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /app

# Copy everything at once to avoid BuildKit ordering bug on Windows
FROM base AS build
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @mc/common run build
RUN pnpm --filter @mc/frontend run build

# Production: serve with nginx, running unprivileged (no root in the container)
FROM nginxinc/nginx-unprivileged:stable-alpine AS production

COPY --from=build /app/packages/frontend/dist /usr/share/nginx/html

# Nginx config for SPA routing + API proxy (written as root, served as nginx)
USER root
RUN printf 'server {\n\
    listen 8080;\n\
    server_name _;\n\
    absolute_redirect off;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
\n\
    client_max_body_size 10m;\n\
\n\
    # Backup downloads stream large archives: no buffering, long read timeout.\n\
    # Scoped to downloads only: a "location /api/backups/" prefix made nginx answer\n\
    # GET /api/backups (no trailing slash) with a 301 to its internal port 8080.\n\
    location ^~ /api/backups/download/ {\n\
        proxy_pass http://backend:3001;\n\
        proxy_http_version 1.1;\n\
        proxy_set_header Host $host;\n\
        proxy_set_header X-Real-IP $remote_addr;\n\
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
        proxy_set_header X-Forwarded-Proto $scheme;\n\
        proxy_buffering off;\n\
        proxy_read_timeout 1h;\n\
        proxy_send_timeout 1h;\n\
    }\n\
\n\
    # Jar uploads: raw body up to 100 MB, streamed to the backend (which enforces the same limit).\n\
    location = /api/mods/upload {\n\
        client_max_body_size 100m;\n\
        proxy_request_buffering off;\n\
        proxy_pass http://backend:3001;\n\
        proxy_http_version 1.1;\n\
        proxy_set_header Host $host;\n\
        proxy_set_header X-Real-IP $remote_addr;\n\
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
        proxy_set_header X-Forwarded-Proto $scheme;\n\
        proxy_read_timeout 10m;\n\
        proxy_send_timeout 10m;\n\
    }\n\
\n\
    location /api {\n\
        proxy_pass http://backend:3001;\n\
        proxy_http_version 1.1;\n\
        proxy_set_header Upgrade $http_upgrade;\n\
        proxy_set_header Connection "upgrade";\n\
        proxy_set_header Host $host;\n\
        proxy_set_header X-Real-IP $remote_addr;\n\
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
        proxy_set_header X-Forwarded-Proto $scheme;\n\
        proxy_read_timeout 60s;\n\
        proxy_send_timeout 60s;\n\
    }\n\
\n\
    location /ws {\n\
        proxy_pass http://backend:3001;\n\
        proxy_http_version 1.1;\n\
        proxy_set_header Upgrade $http_upgrade;\n\
        proxy_set_header Connection "upgrade";\n\
        proxy_set_header Host $host;\n\
        # Idle WebSocket must survive longer than the default 60s read timeout\n\
        proxy_read_timeout 1h;\n\
    }\n\
\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
\n\
    gzip on;\n\
    gzip_types text/plain text/css application/json application/javascript text/xml;\n\
}\n' > /etc/nginx/conf.d/default.conf
USER nginx

EXPOSE 8080
